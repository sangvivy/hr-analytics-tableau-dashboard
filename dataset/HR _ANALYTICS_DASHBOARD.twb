      <aliases enabled='yes' />
      <column caption='Full Name' datatype='string' name='[Calculation_2041847652220928]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[First Name] + &quot; &quot; + [Last Name]' />
      </column>
      <column caption='Age' datatype='integer' name='[Calculation_2041847652962305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [Birthdate], TODAY())&#13;&#10;- &#13;&#10;IF DATEADD(&apos;year&apos;, DATEDIFF(&apos;year&apos;, [Birthdate], TODAY()), [Birthdate]) &gt; TODAY()&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Age-Group' datatype='string' name='[Calculation_2041847653441538]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2041847652962305] &lt; 25 THEN &quot;Under 25&quot;&#13;&#10;ELSEIF [Calculation_2041847652962305] &lt; 35 THEN &quot;25-34&quot;&#13;&#10;ELSEIF [Calculation_2041847652962305] &lt; 45 THEN &quot;35-44&quot;&#13;&#10;ELSEIF [Calculation_2041847652962305] &lt; 55 THEN &quot;45-54&quot;&#13;&#10;ELSE &quot;55+&quot;&#13;&#10;END' />
      </column>
      <column caption='Status' datatype='string' name='[Calculation_2041847654064131]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Termdate]) THEN &quot;Active&quot;&#13;&#10;ELSE &quot;Terminated&quot;&#13;&#10;END' />
      </column>
      <column caption='Total Hired' datatype='integer' name='[Calculation_2041847654219780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Employee_ID])' />
      </column>
      <column caption='% Total Hired' datatype='real' default-format='p0.00%' name='[Calculation_2041847654350853]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Employee_ID]) / TOTAL(COUNTD([Employee_ID]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Highlighted Max' datatype='integer' name='[Calculation_2041847654674438]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Salary]) = WINDOW_MAX(SUM([Salary]))&#13;&#10;THEN SUM([Salary])&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='% Highlighted Max' datatype='real' default-format='p0.00%' name='[Calculation_2041847654883335]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX(SUM([Salary])) / WINDOW_SUM(SUM([Salary]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Active' datatype='integer' name='[Calculation_2041847655862280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_2041847654064131] = &quot;Active&quot;&#13;&#10;    THEN [Employee_ID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='% Total Active' datatype='real' default-format='p0.00%' name='[Calculation_2041847656374281]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_2041847654064131] = &quot;Active&quot;&#13;&#10;    THEN [Employee_ID]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([Employee_ID])' />
      </column>
      <column caption='Total Terminated' datatype='integer' name='[Calculation_2041847656624138]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_2041847654064131] = &quot;Terminated&quot;&#13;&#10;    THEN [Employee_ID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='% Total Terminated' datatype='real' default-format='p0.00%' name='[Calculation_2041847656775691]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_2041847654064131] = &quot;Terminated&quot;&#13;&#10;    THEN [Employee_ID]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([Employee_ID])' />
      </column>
      <column caption='Duration of Time' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_2041847656968204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;day&apos;,&#13;&#10;    [Hiredate],&#13;&#10;    IFNULL([Termdate], TODAY())&#13;&#10;) / 365.25' />
      </column>
      <column caption='Top 2 Rank' datatype='integer' name='[Calculation_2041847657156621]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE(SUM([Salary]), &apos;desc&apos;)'>
          <table-calc ordering-field='[federated.1f493gf1a6jq1r131ny2g1kn71ue].[Calculation_2041847652220928]' ordering-type='Field' />
        </calculation>
      </column>
